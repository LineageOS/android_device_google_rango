type hal_fingerprint_capacitance, domain;
type hal_fingerprint_capacitance_exec, exec_type, file_type, vendor_file_type;

hal_client_domain(hal_fingerprint_capacitance, hal_power)

hal_server_domain(hal_fingerprint_capacitance, hal_fingerprint)

init_daemon_domain(hal_fingerprint_capacitance)

set_prop(hal_fingerprint_capacitance, vendor_fingerprint_prop)

allow hal_fingerprint_capacitance dmabuf_system_heap_device:chr_file { ioctl open read };
allow hal_fingerprint_capacitance fingerprint_device:chr_file { ioctl open read write };
allow hal_fingerprint_capacitance fingerprint_vendor_data_file:dir create_dir_perms;
allow hal_fingerprint_capacitance fwk_sensor_service:service_manager find;
allow hal_fingerprint_capacitance fwk_stats_service:service_manager find;
allow hal_fingerprint_capacitance hal_fingerprint_capacitance:netlink_socket read;
allow hal_fingerprint_capacitance input_device:chr_file { open read };
allow hal_fingerprint_capacitance input_device:dir { open read search };
allow hal_fingerprint_capacitance self:netlink_socket create_socket_perms_no_ioctl;
allow hal_fingerprint_capacitance tee_device:chr_file { ioctl open read write };
allow hal_fingerprint_capacitance uhid_device:chr_file { ioctl open write };
